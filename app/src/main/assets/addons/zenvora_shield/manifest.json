{
  "manifest_version": 2,
  "name": "Zenvora Stealth Shield",
  "version": "2.2.0",
  "description": "Next-gen sub-resource adblocker, pop-under blocker, video aspect controller, and credential auto-capture for Zenvora.",
  "browser_specific_settings": {
    "gecko": {
      "id": "zenvora-shield@zenvora.browser",
      "strict_min_version": "100.0"
    }
  },
  "permissions": [
    "tabs",
    "webRequest",
    "webRequestBlocking",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_shield.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
