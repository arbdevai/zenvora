{
  "manifest_version": 2,
  "name": "Zenvora Stealth Shield",
  "version": "1.6.0",
  "description": "Native sub-resource adblocker, pop-under blocker, and anti-adblock defuser for Zenvora.",
  "browser_specific_settings": {
    "gecko": {
      "id": "zenvora-shield@zenvora.browser",
      "strict_min_version": "100.0"
    }
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_shield.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
